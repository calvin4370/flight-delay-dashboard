# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Problem Statement
docs/problem_statements/*

# Large downloaded / generated data (BTS ~0.9 GB, features, models)
data/raw/bts/
data/processed/
data/models/

# Impeccable engine binary (platform-specific; installed by npx impeccable install)
.claude/skills/impeccable/scripts/bin/

# Python cache
__pycache__/
